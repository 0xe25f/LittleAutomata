# Set default behavior to automatically normalise line endings
* text=auto eol=lf

# Source & Script Files
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.d.ts text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf

# Documentation & Config Files
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary Assets & Media
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.wasm binary
*.bin binary
*.dat binary
*.rle binary
*.wav binary
*.ogg binary
*.mp3 binary
*.zip binary
*.tar.gz binary

# Archive Export Ignores (Exclude development tooling from release archives)
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
AGENTS.md export-ignore
tests export-ignore
examples export-ignore
